{
  "name": "Liver choose interval outcome",
  "gmf_version": 2,
  "remarks": [
    "Generated by scripts/build_liver_modules.py; edit synthea/liver_model.json or the compiler.",
    "All numeric laboratory endpoints, time constants, complication probabilities, and outcome probabilities are illustrative synthetic parameters, not fitted clinical estimates.",
    "Outcome probabilities apply once per completed 24-hour model step, conditional on etiology and current severity; they are not annual risks or transplant eligibility criteria.",
    "Severity is a synthetic acute functional impairment index from 0 to 1, separate from hepatocyte injury activity and chronic baseline abnormalities.",
    "Clinical pattern references: https://www.aasld.org/liver-fellow-network/core-series/back-basics/defining-and-managing-acute-liver-failure and https://www.aasld.org/liver-fellow-network/core-series/clinical-pearls/management-acute-chronic-liver-failure"
  ],
  "states": {
    "Terminal": {
      "type": "Terminal"
    },
    "Record_outcome_0": {
      "type": "SetAttribute",
      "attribute": "liver_last_outcome_day",
      "value_attribute": "liver_elapsed_days",
      "direct_transition": "Terminal"
    },
    "Outcome_recovery_0": {
      "type": "SetAttribute",
      "attribute": "liver_suggested_outcome",
      "value": "recovery",
      "direct_transition": "Record_outcome_0"
    },
    "Outcome_deterioration_0": {
      "type": "SetAttribute",
      "attribute": "liver_suggested_outcome",
      "value": "deterioration",
      "direct_transition": "Record_outcome_0"
    },
    "Outcome_death_0": {
      "type": "SetAttribute",
      "attribute": "liver_suggested_outcome",
      "value": "death",
      "direct_transition": "Record_outcome_0"
    },
    "Outcome_transplant_evaluation_0": {
      "type": "SetAttribute",
      "attribute": "liver_suggested_outcome",
      "value": "transplant_evaluation",
      "direct_transition": "Record_outcome_0"
    },
    "Outcome_continue_0": {
      "type": "SetAttribute",
      "attribute": "liver_suggested_outcome",
      "value": "continue",
      "direct_transition": "Record_outcome_0"
    },
    "Choose": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": {
            "attribute": "liver_p_recovery",
            "default": 0.0
          },
          "transition": "Outcome_recovery_0"
        },
        {
          "distribution": {
            "attribute": "liver_p_deterioration",
            "default": 0.0
          },
          "transition": "Outcome_deterioration_0"
        },
        {
          "distribution": {
            "attribute": "liver_p_death",
            "default": 0.0
          },
          "transition": "Outcome_death_0"
        },
        {
          "distribution": {
            "attribute": "liver_p_transplant_evaluation",
            "default": 0.0
          },
          "transition": "Outcome_transplant_evaluation_0"
        },
        {
          "distribution": {
            "attribute": "liver_p_continue",
            "default": 0.0
          },
          "transition": "Outcome_continue_0"
        }
      ]
    },
    "Check_due": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_outcome_due",
            "operator": "==",
            "value": true
          },
          "transition": "Choose"
        },
        {
          "transition": "Terminal"
        }
      ]
    },
    "Due_0": {
      "type": "SetAttribute",
      "attribute": "liver_outcome_due",
      "expression": "#{liver_elapsed_days} > #{liver_last_outcome_day} and #{liver_last_assessed_day} = #{liver_elapsed_days}",
      "direct_transition": "Check_due"
    },
    "Check_error": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_error",
            "operator": "is nil"
          },
          "transition": "Due_0"
        },
        {
          "transition": "Terminal"
        }
      ]
    },
    "Error_11_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Initialize before choosing an outcome",
      "direct_transition": "Terminal"
    },
    "Check_active": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_active",
            "operator": "==",
            "value": true
          },
          "transition": "Check_error"
        },
        {
          "transition": "Error_11_0"
        }
      ]
    },
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_active"
    }
  }
}
