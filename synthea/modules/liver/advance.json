{
  "name": "Liver advance one day",
  "gmf_version": 2,
  "remarks": [
    "Generated by scripts/build_liver_modules.py; edit synthea/liver_model.json or the compiler.",
    "All numeric laboratory endpoints, time constants, complication probabilities, and outcome probabilities are illustrative synthetic parameters, not fitted clinical estimates.",
    "Outcome probabilities apply once per completed 24-hour model step, conditional on etiology and current severity; they are not annual risks or transplant eligibility criteria.",
    "Severity is a synthetic acute functional impairment index from 0 to 1, separate from hepatocyte injury activity and chronic baseline abnormalities.",
    "Clinical pattern references: https://www.aasld.org/liver-fellow-network/core-series/back-basics/defining-and-managing-acute-liver-failure and https://www.aasld.org/liver-fellow-network/core-series/clinical-pearls/management-acute-chronic-liver-failure"
  ],
  "states": {
    "Terminal": {
      "type": "Terminal"
    },
    "Advance_0": {
      "type": "Delay",
      "distribution": {
        "kind": "EXACT",
        "parameters": {
          "value": 24
        }
      },
      "unit": "hours",
      "direct_transition": "Advance_1"
    },
    "Advance_1": {
      "type": "Counter",
      "attribute": "liver_elapsed_days",
      "action": "increment",
      "direct_transition": "Advance_2"
    },
    "Advance_2": {
      "type": "CallSubmodule",
      "submodule": "liver/assess",
      "direct_transition": "Terminal"
    },
    "Error_4_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Postoperative course requires transplant_status=recipient",
      "direct_transition": "Terminal"
    },
    "Validate_postoperative": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "liver_trajectory",
                "operator": "==",
                "value": "postoperative"
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_transplant_status",
                "operator": "!=",
                "value": "recipient"
              }
            ]
          },
          "transition": "Error_4_0"
        },
        {
          "transition": "Advance_0"
        }
      ]
    },
    "Error_6_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "A cirrhosis profile requires preexisting_cirrhosis=true",
      "direct_transition": "Terminal"
    },
    "Validate_cirrhosis": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "alcohol_cirrhosis"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "cirrhosis"
                  }
                ]
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_preexisting_cirrhosis",
                "operator": "==",
                "value": false
              }
            ]
          },
          "transition": "Error_6_0"
        },
        {
          "transition": "Validate_postoperative"
        }
      ]
    },
    "Error_8_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Invalid renal baseline, cirrhosis flag, alcohol use, or transplant status",
      "direct_transition": "Terminal"
    },
    "Validate_baseline": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "liver_renal_baseline",
                "operator": ">",
                "value": 0
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_renal_baseline",
                "operator": "<=",
                "value": 20
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_preexisting_cirrhosis",
                    "operator": "==",
                    "value": true
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_preexisting_cirrhosis",
                    "operator": "==",
                    "value": false
                  }
                ]
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "none"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "evaluating"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "listed"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "recipient"
                  }
                ]
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "unknown"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "active"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "abstinent"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "not_applicable"
                  }
                ]
              }
            ]
          },
          "transition": "Validate_cirrhosis"
        },
        {
          "transition": "Error_8_0"
        }
      ]
    },
    "Error_10_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Unsupported liver inputs",
      "direct_transition": "Terminal"
    },
    "Validate_inputs": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "alcohol_cirrhosis"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "acetaminophen"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "non_acetaminophen"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "cirrhosis"
                  }
                ]
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "recovery"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "deterioration"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "stable"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "postoperative"
                  }
                ]
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_initial_severity",
                "operator": ">=",
                "value": 0
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_initial_severity",
                "operator": "<=",
                "value": 1
              }
            ]
          },
          "transition": "Validate_baseline"
        },
        {
          "transition": "Error_10_0"
        }
      ]
    },
    "Error_12_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Initialize before advancing",
      "direct_transition": "Terminal"
    },
    "Check_active": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_active",
            "operator": "==",
            "value": true
          },
          "transition": "Validate_inputs"
        },
        {
          "transition": "Error_12_0"
        }
      ]
    },
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_active"
    }
  }
}
