                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_encephalopathy_grade",
                    "operator": ">=",
                    "value": 3
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_renal_dysfunction",
                    "operator": "==",
                    "value": true
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_respiratory_dysfunction",
                    "operator": "==",
                    "value": true
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_circulatory_dysfunction",
                    "operator": "==",
                    "value": true
                  }
                ]
              }
            ]
          },
          "transition": "ACLF_label_0"
        },
        {
          "transition": "Decomp_label_0"
