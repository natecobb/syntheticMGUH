{
  "name": "Liver initialize",
  "gmf_version": 2,
  "remarks": [
    "Generated by scripts/build_liver_modules.py; edit synthea/liver_model.json or the compiler.",
    "All numeric laboratory endpoints, time constants, complication probabilities, and outcome probabilities are illustrative synthetic parameters, not fitted clinical estimates.",
    "Outcome probabilities apply once per completed 24-hour model step, conditional on etiology and current severity; they are not annual risks or transplant eligibility criteria.",
    "Severity is a synthetic acute functional impairment index from 0 to 1, separate from hepatocyte injury activity and chronic baseline abnormalities.",
    "Clinical pattern references: https://www.aasld.org/liver-fellow-network/core-series/back-basics/defining-and-managing-acute-liver-failure and https://www.aasld.org/liver-fellow-network/core-series/clinical-pearls/management-acute-chronic-liver-failure"
  ],
  "states": {
    "Terminal": {
      "type": "Terminal"
    },
    "Initialize_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "direct_transition": "Initialize_1"
    },
    "Initialize_1": {
      "type": "Counter",
      "attribute": "liver_episode",
      "action": "increment",
      "direct_transition": "Initialize_2"
    },
    "Initialize_2": {
      "type": "SetAttribute",
      "attribute": "liver_model_version",
      "value": "1.4-demo",
      "direct_transition": "Initialize_3"
    },
    "Initialize_3": {
      "type": "SetAttribute",
      "attribute": "liver_active",
      "value": true,
      "direct_transition": "Initialize_4"
    },
    "Initialize_4": {
      "type": "SetAttribute",
      "attribute": "liver_entry_path",
      "value": "direct_icu",
      "direct_transition": "Initialize_5"
    },
    "Initialize_5": {
      "type": "SetAttribute",
      "attribute": "liver_elapsed_days",
      "value": 0,
      "direct_transition": "Initialize_6"
    },
    "Initialize_6": {
      "type": "SetAttribute",
      "attribute": "liver_phase_start_day",
      "value": 0,
      "direct_transition": "Initialize_7"
    },
    "Initialize_7": {
      "type": "SetAttribute",
      "attribute": "liver_last_assessed_day",
      "value": -1,
      "direct_transition": "Initialize_8"
    },
    "Initialize_8": {
      "type": "SetAttribute",
      "attribute": "liver_last_outcome_day",
      "value": 0,
      "direct_transition": "Initialize_9"
    },
    "Initialize_9": {
      "type": "SetAttribute",
      "attribute": "liver_suggested_outcome",
      "value": "continue",
      "direct_transition": "Initialize_10"
    },
    "Initialize_10": {
      "type": "SetAttribute",
      "attribute": "liver_phase_initial_severity",
      "value_attribute": "liver_initial_severity",
      "direct_transition": "Initialize_11"
    },
    "Initialize_11": {
      "type": "SetAttribute",
      "attribute": "liver_phase_initial_injury",
      "value_attribute": "liver_initial_severity",
      "direct_transition": "Initialize_12"
    },
    "Initialize_12": {
      "type": "SetAttribute",
      "attribute": "liver_current_trajectory",
      "value_attribute": "liver_trajectory",
      "direct_transition": "Initialize_13"
    },
    "Initialize_13": {
      "type": "SetAttribute",
      "attribute": "liver_renal_draw",
      "distribution": {
        "kind": "UNIFORM",
        "parameters": {
          "low": 0,
          "high": 1
        }
      },
      "direct_transition": "Initialize_14"
    },
    "Initialize_14": {
      "type": "SetAttribute",
      "attribute": "liver_respiratory_draw",
      "distribution": {
        "kind": "UNIFORM",
        "parameters": {
          "low": 0,
          "high": 1
        }
      },
      "direct_transition": "Initialize_15"
    },
    "Initialize_15": {
      "type": "SetAttribute",
      "attribute": "liver_circulatory_draw",
      "distribution": {
        "kind": "UNIFORM",
        "parameters": {
          "low": 0,
          "high": 1
        }
      },
      "direct_transition": "Initialize_16"
    },
    "Initialize_16": {
      "type": "SetAttribute",
      "attribute": "liver_lab_scale",
      "distribution": {
        "kind": "UNIFORM",
        "parameters": {
          "low": 0.95,
          "high": 1.05
        }
      },
      "direct_transition": "Initialize_17"
    },
    "Initialize_17": {
      "type": "CallSubmodule",
      "submodule": "liver/assess",
      "direct_transition": "Terminal"
    },
    "Error_19_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Postoperative course requires transplant_status=recipient",
      "direct_transition": "Terminal"
    },
    "Validate_postoperative": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "liver_trajectory",
                "operator": "==",
                "value": "postoperative"
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_transplant_status",
                "operator": "!=",
                "value": "recipient"
              }
            ]
          },
          "transition": "Error_19_0"
        },
        {
          "transition": "Initialize_0"
        }
      ]
    },
    "Error_21_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "A cirrhosis profile requires preexisting_cirrhosis=true",
      "direct_transition": "Terminal"
    },
    "Validate_cirrhosis": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "alcohol_cirrhosis"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "cirrhosis"
                  }
                ]
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_preexisting_cirrhosis",
                "operator": "==",
                "value": false
              }
            ]
          },
          "transition": "Error_21_0"
        },
        {
          "transition": "Validate_postoperative"
        }
      ]
    },
    "Error_23_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Invalid renal baseline, cirrhosis flag, alcohol use, or transplant status",
      "direct_transition": "Terminal"
    },
    "Validate_baseline": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "liver_renal_baseline",
                "operator": ">",
                "value": 0
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_renal_baseline",
                "operator": "<=",
                "value": 20
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_preexisting_cirrhosis",
                    "operator": "==",
                    "value": true
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_preexisting_cirrhosis",
                    "operator": "==",
                    "value": false
                  }
                ]
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "none"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "evaluating"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "listed"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_transplant_status",
                    "operator": "==",
                    "value": "recipient"
                  }
                ]
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "unknown"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "active"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "abstinent"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_alcohol_use",
                    "operator": "==",
                    "value": "not_applicable"
                  }
                ]
              }
            ]
          },
          "transition": "Validate_cirrhosis"
        },
        {
          "transition": "Error_23_0"
        }
      ]
    },
    "Default_alcohol_use_0": {
      "type": "SetAttribute",
      "attribute": "liver_alcohol_use",
      "expression": "if #s{liver_etiology} = 'alcohol_cirrhosis' or #s{liver_etiology} = 'cirrhosis' then 'unknown' else 'not_applicable'",
      "direct_transition": "Validate_baseline"
    },
    "Check_alcohol_use": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_alcohol_use",
            "operator": "is nil"
          },
          "transition": "Default_alcohol_use_0"
        },
        {
          "transition": "Validate_baseline"
        }
      ]
    },
    "Default_transplant_status_0": {
      "type": "SetAttribute",
      "attribute": "liver_transplant_status",
      "value": "none",
      "direct_transition": "Check_alcohol_use"
    },
    "Check_transplant_status": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_transplant_status",
            "operator": "is nil"
          },
          "transition": "Default_transplant_status_0"
        },
        {
          "transition": "Check_alcohol_use"
        }
      ]
    },
    "Default_renal_baseline_0": {
      "type": "SetAttribute",
      "attribute": "liver_renal_baseline",
      "value": 0.9,
      "direct_transition": "Check_transplant_status"
    },
    "Check_renal_baseline": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_renal_baseline",
            "operator": "is nil"
          },
          "transition": "Default_renal_baseline_0"
        },
        {
          "transition": "Check_transplant_status"
        }
      ]
    },
    "Default_preexisting_cirrhosis_0": {
      "type": "SetAttribute",
      "attribute": "liver_preexisting_cirrhosis",
      "expression": "#s{liver_etiology} = 'alcohol_cirrhosis' or #s{liver_etiology} = 'cirrhosis'",
      "direct_transition": "Check_renal_baseline"
    },
    "Check_preexisting_cirrhosis": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_preexisting_cirrhosis",
            "operator": "is nil"
          },
          "transition": "Default_preexisting_cirrhosis_0"
        },
        {
          "transition": "Check_renal_baseline"
        }
      ]
    },
    "Error_33_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Set a supported etiology, trajectory, and initial_severity in [0,1]",
      "direct_transition": "Terminal"
    },
    "Validate_inputs": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "alcohol_cirrhosis"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "acetaminophen"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "non_acetaminophen"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "cirrhosis"
                  }
                ]
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "recovery"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "deterioration"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "stable"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "postoperative"
                  }
                ]
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_initial_severity",
                "operator": ">=",
                "value": 0
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_initial_severity",
                "operator": "<=",
                "value": 1
              }
            ]
          },
          "transition": "Check_preexisting_cirrhosis"
        },
        {
          "transition": "Error_33_0"
        }
      ]
    },
    "Error_35_0": {
      "type": "SetAttribute",
      "attribute": "liver_error",
      "value": "Finish the active episode before initializing another",
      "direct_transition": "Terminal"
    },
    "Check_active": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_active",
            "operator": "==",
            "value": true
          },
          "transition": "Error_35_0"
        },
        {
          "transition": "Validate_inputs"
        }
      ]
    },
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_active"
    }
  }
}
