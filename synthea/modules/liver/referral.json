    "Existing_decision": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_referral_decision_case_id",
            "operator": "is not nil"
          },
          "transition": "Check_case_0"
        },
        {
          "transition": "Draw"
        }
