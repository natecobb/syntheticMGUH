      "direct_transition": "Record_0"
    },
    "Elsewhere_0": {
      "type": "SetAttribute",
      "attribute": "liver_referred_to_mguh",
      "value": false,
      "direct_transition": "Record_0"
    },
    "Draw": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.25,
          "transition": "Referred_0"
