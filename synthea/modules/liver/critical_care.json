          },
          "transition": "Recover_0"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_suggested_outcome",
            "operator": "==",
            "value": "deterioration"
          },
          "transition": "Deteriorate_0"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_suggested_outcome",
            "operator": "==",
            "value": "transplant_evaluation"
          },
          "transition": "Can_evaluate"
        },
        {
          "transition": "ICU_day_0"
        }
      ]
