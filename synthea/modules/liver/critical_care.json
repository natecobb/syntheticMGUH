      "direct_transition": "Terminal"
    },
    "After_discharge": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "liver_transplant_status",
            "operator": "==",
            "value": "recipient"
          },
          "transition": "Recipient_discharge_0"
        },
        {
          "transition": "Complete_0"
        }
      ]
    },
    "Ward_0": {
      "type": "CallSubmodule",
      "submodule": "liver/stop_support",
      "direct_transition": "Ward_1"
    },
    "Ward_1": {
      "type": "CallSubmodule",
      "submodule": "liver/resolve_conditions",
      "direct_transition": "Ward_2"
    },
    "Ward_2": {
      "type": "EncounterEnd",
      "direct_transition": "Ward_3"
