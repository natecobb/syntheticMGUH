                    "condition_type": "Attribute",
                    "attribute": "liver_etiology",
                    "operator": "==",
                    "value": "cirrhosis"
                  }
                ]
              },
              {
                "condition_type": "Or",
                "conditions": [
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "recovery"
                  },
                  {
                    "condition_type": "Attribute",
                    "attribute": "liver_trajectory",
                    "operator": "==",
                    "value": "deterioration"
                  },
