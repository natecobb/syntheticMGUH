    "Can_evaluate": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "liver_evaluation_done",
                "operator": "==",
                "value": false
              },
              {
                "condition_type": "Attribute",
                "attribute": "liver_transplant_status",
                "operator": "==",
                "value": "none"
              }
            ]
          },
          "transition": "Transplant_0"
        },
