    "Manage_Delay": {
      "type": "Delay",
      "remarks": [
        "These synthetic branch probabilities apply once after each completed 4-10 month management delay. They are not annual mortality or complication rates.",
        "The previously unallocated 0.20 explicitly continues management with a new delay and no clinical event. This modeling assumption preserves the existing follow-up (0.66), complication (0.10), and death-state selection (0.04) probabilities; it is not clinically calibrated.",
        "Follow-up can wait for a wellness encounter. The disease-death branch waits 1-12 months and rechecks native cirrhosis and transplant status before recording death."
      ],
      "range": {
        "low": 4,
        "high": 10,
        "unit": "months"
      },
      "distributed_transition": [
        {
          "distribution": 0.66,
          "transition": "Followup_Encounter"
        },
        {
          "distribution": 0.1,
          "transition": "Complication_Encounter"
        },
        {
          "distribution": 0.04,
          "transition": "Disease_Death"
        },
        {
          "distribution": 0.2,
          "transition": "Manage_Delay"
        }
      ]
    },
